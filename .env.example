# AptiQuiz Environment Variables
PORT=3000
NODE_ENV=development

# MySQL Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=aptiquiz_db
DB_PORT=3306

# Security & Secrets
JWT_SECRET=aptiquiz_jwt_super_secret_hackathon_2026_key
SESSION_SECRET=aptiquiz_session_secret_key_987654

# AI Question Generator (Optional - falls back to built-in algorithmic generator if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Game Defaults
DEFAULT_QUESTION_DURATION=15
MAX_ROOM_CAPACITY=50
RECONNECT_GRACE_PERIOD_SEC=60
